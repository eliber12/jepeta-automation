  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Risk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "score",
          "level",
          "reason_codes",
          "explanation"
        ],
        "properties": {
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "level": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL",
              null
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string"
          }
        }
      },
      "EvidenceQualityIssue": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "signal"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "REQUIRED",
              "OPTIONAL"
            ]
          },
          "signal": {
            "type": "string"
          }
        }
      },
      "EvidenceQuality": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "issues"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceQualityIssue"
            }
          }
        }
      },
      "EvidenceSource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "EvidenceItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal",
          "value",
          "unit",
          "status",
          "source",
          "observed_at"
        ],
        "properties": {
          "signal": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "UNKNOWN",
              "UNAVAILABLE",
              "PARTIAL",
              "RATE_LIMITED",
              "ERROR",
              "STALE"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/EvidenceSource"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SourceStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "role",
          "required",
          "status",
          "error_code",
          "retryable",
          "observed_at"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "required_security",
              "optional"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Conflict": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal",
          "status",
          "reason",
          "sources"
        ],
        "properties": {
          "signal": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DISAGREE",
              "INSUFFICIENT",
              "NOT_COMPARABLE",
              "STALE"
            ]
          },
          "reason": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Freshness": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "observed_at",
          "oldest_observed_at",
          "newest_observed_at"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "FRESH",
              "MIXED",
              "STALE",
              "UNKNOWN"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "oldest_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "newest_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Failure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "reasons"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RiskScanV5": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "api_version",
          "release_status",
          "canonical",
          "chain_id",
          "token_address",
          "status",
          "verdict",
          "risk_engine_version",
          "methodology_version",
          "risk",
          "evidence_quality",
          "verification",
          "onchain_evidence",
          "security_evidence",
          "market_context",
          "source_status",
          "conflicts",
          "freshness",
          "failure"
        ],
        "properties": {
          "schema_version": {
            "const": "5.0.0-internal.1"
          },
          "api_version": {
            "const": "v5"
          },
          "release_status": {
            "type": "string",
            "enum": [
              "internal",
              "public"
            ],
            "description": "internal when V5 is explicit optional; public when V5 is canonical."
          },
          "canonical": {
            "type": "boolean",
            "description": "False with internal release status; true with public release status."
          },
          "chain_id": {
            "const": 8453
          },
          "token_address": {
            "type": "string",
            "pattern": "^0x[a-f0-9]{40}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "VERDICT",
              "NO_VERDICT"
            ]
          },
          "verdict": {
            "type": [
              "string",
              "null"
