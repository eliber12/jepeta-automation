              "Allow": {
                "schema": {
                  "const": "POST"
                }
              },
              "X-Jepeta-API-Version": {
                "schema": {
                  "const": "v5"
                }
              },
              "X-Jepeta-V5-Rollout": {
                "schema": {
                  "const": "public"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Jepeta-API-Version": {
                "schema": {
                  "const": "v5"
                }
              },
              "X-Jepeta-V5-Rollout": {
                "schema": {
                  "const": "public"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Jepeta-API-Version": {
                "schema": {
                  "const": "v5"
                }
              },
              "X-Jepeta-V5-Rollout": {
                "schema": {
                  "const": "public"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "422": {
            "description": "Required security evidence is malformed, unavailable, stale, conflicting or uncovered; no verdict is issued. A valid GoPlus cannot_sell_all omission alone is not a 422 condition under methodology 2.1.1.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskScanV5"
                }
              }
            },
            "headers": {
              "X-Jepeta-API-Version": {
                "schema": {
                  "const": "v5"
                }
              },
              "X-Jepeta-V5-Rollout": {
                "schema": {
                  "const": "public"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "429": {
            "description": "Public ingress or required security provider rate limit; no false verdict is issued.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300
                }
              },
              "X-Jepeta-API-Version": {
                "schema": {
                  "const": "v5"
                }
              },
              "X-Jepeta-V5-Rollout": {
                "schema": {
                  "const": "public"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RiskScanV5"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Malformed or unexpected internal state; no verdict is issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Jepeta-API-Version": {
                "schema": {
                  "const": "v5"
                }
              },
              "X-Jepeta-V5-Rollout": {
                "schema": {
                  "const": "public"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "503": {
            "description": "Required security unavailable/partial/stale/conflicting, or public ingress unavailable; no false verdict is issued.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300
                }
              },
              "X-Jepeta-API-Version": {
                "schema": {
                  "const": "v5"
                }
              },
              "X-Jepeta-V5-Rollout": {
                "schema": {
                  "const": "public"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RiskScanV5"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
