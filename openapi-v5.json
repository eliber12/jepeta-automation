{
  "openapi": "3.1.0",
  "info": {
    "title": "Jepeta Risk Guard API V5 - Canonical",
    "version": "5.0.0-internal.1",
    "description": "Canonical public V5 risk scan through POST /jepeta-risk-scan, with the equivalent explicit POST /jepeta-risk-scan-v5 route. V4 GET remains active and supported through the default GET and explicit V4 endpoint. Pricing and paid/private exposure are unchanged.",
    "x-jepeta-internal-only": false,
    "x-jepeta-canonical": true,
    "x-risk-engine": "3.0.0-shadow.3",
    "x-methodology-version": "2.1.1",
    "x-jepeta-public-optional": false
  },
  "servers": [
    {
      "url": "https://aitgmgfumsdqecmanrab.supabase.co/functions/v1"
    }
  ],
  "paths": {
    "/jepeta-risk-scan": {
      "post": {
        "operationId": "scanBaseTokenV5Default",
        "summary": "Run the canonical public V5 Base token risk scan",
        "description": "Default POST route for V5 while the service-role canonical switch is enabled. A disabled switch restores V4 default GET with POST rejected; explicit V4 GET remains supported throughout.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tokenAddress"
                ],
                "properties": {
                  "tokenAddress": {
                    "type": "string",
                    "pattern": "^0x[a-fA-F0-9]{40}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "V5 verdict. A valid GoPlus cannot_sell_all omission remains UNKNOWN in logical_signals, degrades evidence_quality, and may coexist with a verdict. Unconfirmed exact-token liquidity yields WARN with zero score delta. No false sellability or liquidity value is invented. Malformed, stale, unavailable or conflicting required security evidence yields NO_VERDICT.",
            "headers": {
              "X-Jepeta-API-Version": {
                "schema": {
                  "const": "v5"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Jepeta-V5-Rollout": {
                "schema": {
                  "const": "public"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskScanV5"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or token address",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Jepeta-API-Version": {
                "schema": {
                  "const": "v5"
                }
              },
              "X-Jepeta-V5-Rollout": {
                "schema": {
                  "const": "public"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "404": {
            "description": "V5 feature flag is disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Jepeta-API-Version": {
                "schema": {
                  "const": "v5"
                }
              },
              "X-Jepeta-V5-Rollout": {
                "schema": {
                  "const": "public"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "405": {
            "description": "POST required",
