{
  "openapi": "3.1.0",
  "info": {
    "title": "Jepeta Risk Guard API",
    "version": "4.3.0",
    "description": "Fail-closed pre-trade risk guard for Base agents. GET-only Base ERC-20 risk intelligence for exact-token screening, recent public signals, and permanent evidence-rich public snapshots. PASS/WARN/BLOCK is screening, not a safety guarantee. Paid-only evidence remains separate through Virtuals ACP.",
    "x-canonical-url": "https://jepeta.dev/",
    "x-last-updated": "2026-09-26",
    "x-supported-chain": {
      "name": "Base",
      "chainId": 8453
    },
    "x-free-vs-paid": {
      "free": "Public GET exact-token preview plus public discovery risk feed.",
      "paid": "Full evidence report through Virtuals ACP v2 / token_risk_scan.",
      "priceUSDC": "0.03"
    },
    "x-methodology": "https://jepeta.dev/methodology.json",
    "x-changelog": "https://jepeta.dev/changelog.json"
  },
  "servers": [
    {
      "url": "https://aitgmgfumsdqecmanrab.supabase.co/functions/v1"
    }
  ],
  "paths": {
    "/jepeta-risk-scan": {
      "get": {
        "operationId": "scanBaseToken",
        "summary": "Scan one exact Base ERC-20 contract",
        "parameters": [
          {
            "name": "tokenAddress",
            "in": "query",
            "required": true,
            "description": "Exact Base ERC-20 contract address.",
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Strict public preview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewV4"
                }
              }
            },
            "headers": {
              "X-Jepeta-Cache": {
                "description": "Whether this successful response was served from the short server-side token cache.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "HIT",
                    "MISS"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid address or request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed. Public scanning is GET-only.",
            "headers": {
              "Allow": {
                "description": "Allowed public methods.",
                "schema": {
                  "type": "string",
                  "const": "GET, OPTIONS"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Exact token lacks required GoPlus coverage or an explicit honeypot/mintable boolean",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Jepeta server-side rate limit or required GoPlus rate limit. Honor Retry-After before retrying.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Suggested retry delay in seconds."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required security provider unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Public endpoint. GET only. Responses may be served from a short (~30s) per-token cache. Repeated requests are server-rate-limited."
      }
    },
    "/jepeta-risk-feed": {
      "get": {
        "operationId": "listRecentBaseRiskSignals",
        "summary": "List recent publicly published Base risk signals",
        "description": "Discovery-only feed. It exposes recent token, decision, risk/trend scores and timestamps already published by Jepeta; it does not expose paid evidence.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 168,
              "default": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent public risk signals",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskFeedV1"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed. Risk feed is GET-only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited. Honor Retry-After.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Risk feed unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jepeta-risk-evidence": {
      "get": {
        "operationId": "getPublicBaseRiskEvidence",
        "summary": "Get permanent public Base token risk evidence or list the evidence catalog",
        "description": "Only evidence-rich tokens that already passed Jepeta's public publication gate are eligible. Ordinary scans are not auto-indexed. Public evidence excludes paid-only dangerous-permission flags and trading-activity evidence.",
        "parameters": [
          {
            "name": "tokenAddress",
            "in": "query",
            "required": false,
            "description": "Exact Base ERC-20 contract. Omit to list the catalog.",
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence detail or catalog",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PublicRiskEvidenceV1"
                    },
                    {
                      "$ref": "#/components/schemas/PublicRiskEvidenceCatalogV1"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No indexable evidence exists for the exact token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed. Evidence API is GET-only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited. Honor Retry-After.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Evidence service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jepeta-risk-intelligence": {
      "get": {
        "operationId": "getBaseRiskIntelligence",
        "summary": "Get aggregate monthly Jepeta Base risk research",
        "description": "Returns observational aggregate telemetry only. One latest HIGH/MEDIUM-quality observation per unique token is counted per month. The sample is not a census of all Base tokens.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly research catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed. Research API is GET-only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited. Honor Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Research service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PreviewV4": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "chain_id",
          "token_address",
          "decision",
          "risk_score",
          "risk_level",
          "is_honeypot",
          "is_mintable",
          "buy_tax_percent",
          "sell_tax_percent",
          "top10_holder_concentration_percent",
          "top10_holder_count",
          "lp_locked_percent_observed",
          "lp_holder_sample_count",
          "liquidity_usd",
          "data_quality",
          "source_status",
          "warnings",
          "observed_at",
          "paid_report"
        ],
        "properties": {
          "schema_version": {
            "const": "4.0.0"
          },
          "chain_id": {
            "const": 8453
          },
          "token_address": {
            "type": "string",
            "pattern": "^0x[a-f0-9]{40}$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "PASS",
              "WARN",
              "BLOCK"
            ],
            "description": "Machine policy hint. PASS means no configured BLOCK/WARN condition was observed; it is not a safety guarantee."
          },
          "risk_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "is_honeypot": {
            "type": "boolean",
            "description": "Explicit GoPlus honeypot signal. Unknown does not become false; it yields HTTP 422."
          },
          "is_mintable": {
            "type": "boolean",
            "description": "Explicit GoPlus mintability signal. Unknown does not become false; it yields HTTP 422."
          },
          "buy_tax_percent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "sell_tax_percent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "top10_holder_concentration_percent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "Observed sum of valid percentages from up to 10 GoPlus holder records."
          },
          "top10_holder_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "lp_locked_percent_observed": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "Observed locked percentage within up to 10 GoPlus LP-holder records. This is sample coverage, not proof that all liquidity is locked."
          },
          "lp_holder_sample_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "liquidity_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Largest exact matching Base-pair liquidity returned by DEX Screener."
          },
          "data_quality": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "source_status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "goplus",
              "dexscreener"
            ],
            "properties": {
              "goplus": {
                "const": "OK"
              },
              "dexscreener": {
                "type": "string",
                "enum": [
                  "OK",
                  "PARTIAL",
                  "RATE_LIMITED",
                  "UNAVAILABLE"
                ]
              }
            }
          },
          "warnings": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string"
            }
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "paid_report": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol",
              "offering",
              "priceUSDC",
              "providerWallet"
            ],
            "properties": {
              "protocol": {
                "const": "Virtuals ACP v2"
              },
              "offering": {
                "const": "Token Risk Scan"
              },
              "priceUSDC": {
                "const": "0.03"
              },
              "providerWallet": {
                "const": "0xefcb0359e2cd6d1ad92cbca1e41c8946b308d7df"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "RiskSignalV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chainId",
          "tokenAddress",
          "decision",
          "riskScore",
          "trendScore",
          "observedAt",
          "sourcePlatform",
          "scanUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^publication:[0-9]+$"
          },
          "chainId": {
            "const": 8453
          },
          "tokenAddress": {
            "type": "string",
            "pattern": "^0x[a-f0-9]{40}$"
          },
