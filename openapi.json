              "farcaster"
            ]
          },
          "scanUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "RiskFeedV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "schemaVersion",
          "chainId",
          "generatedAt",
          "windowHours",
          "count",
          "signals",
          "paidReport",
          "semantics",
          "service"
        ],
        "properties": {
